{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farrosh",
  "version": "1.0.0",
  "identifier": "uz.farrosh.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Farrosh",
        "width": 1140,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Farrosh",
    "shortDescription": "Windows'ni keraksiz fayllardan tozalash",
    "longDescription": "Kesh, vaqtinchalik fayllar, o'rnatish fayllari, ilovalar qoldig'i, katta fayllar va dublikatlarni topib tozalaydi.",
    "copyright": "Farrosh",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
